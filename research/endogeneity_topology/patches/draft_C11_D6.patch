diff --git a/src/eia/intention/__init__.py b/src/eia/intention/__init__.py
index 98c194c..1a36cd9 100644
--- a/src/eia/intention/__init__.py
+++ b/src/eia/intention/__init__.py
@@ -18,9 +18,41 @@ class IntentionGenesis:
         *,
         abstain_threshold: float = 0.35,
         min_evsi: float = 0.15,
+        state_ior: bool = False,
+        ior_delta: float = 0.05,
     ) -> None:
         self.abstain_threshold = abstain_threshold
         self.min_evsi = min_evsi
+        # State-dependent inhibition of return: a target asked at entropy H0 is re-admitted only when
+        # its belief entropy exceeds H0 + ior_delta (knowledge went stale / new conflicting evidence).
+        # Fixed-decay IOR would be a hidden clock (research/endogeneity_topology ticks 53-56).
+        self.state_ior = state_ior
+        self.ior_delta = ior_delta
+        self.asked_entropy: dict[str, float] = {}
+
+    @staticmethod
+    def _belief_entropy(field: BeliefField, belief_id: str) -> float | None:
+        belief = field.beliefs.get(belief_id)
+        if belief is None:
+            return None
+        from eia.beliefs import shannon_entropy
+
+        return shannon_entropy(belief.distribution) if belief.distribution else belief.uncertainty
+
+    def note_asked(self, initiative: Initiative, field: BeliefField) -> None:
+        """Record the target's entropy when a question was emitted (call after emission)."""
+        c = initiative.candidate
+        if initiative.abstained or c is None or c.target_belief_id is None:
+            return
+        h = self._belief_entropy(field, c.target_belief_id)
+        if h is not None:
+            self.asked_entropy[c.target_belief_id] = h
+
+    def _ior_admits(self, c: InitiativeCandidate, field: BeliefField) -> bool:
+        if not self.state_ior or c.target_belief_id not in self.asked_entropy:
+            return True
+        h = self._belief_entropy(field, c.target_belief_id)
+        return h is not None and h > self.asked_entropy[c.target_belief_id] + self.ior_delta
 
     def generate_candidates(
         self,
@@ -136,6 +168,7 @@ class IntentionGenesis:
         non_abstain = [
             c for c in candidates
             if c.kind not in (InitiativeKind.ABSTAIN, InitiativeKind.OBSERVE)
+            and self._ior_admits(c, field)
         ]
         observe = next((c for c in candidates if c.kind == InitiativeKind.OBSERVE), None)
 
