@@ -0,0 +1,50 @@
+"""Opt-in PopulationDrives engine (research/endogeneity_topology, config v3)."""
+
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from eia.pipeline import run_scenario
+
+ROOT = Path(__file__).resolve().parents[1]
+SCENARIOS = sorted((ROOT / "evals").glob("twin_world_*.yaml")) + [
+    ROOT / "scenarios" / "twin_world_001.yaml", ROOT / "scenarios" / "autonomous_question.yaml"]
+
+
+def _sig(r):
+    c = r["initiative"].candidate
+    return (r["initiative"].abstained, c.kind.value if c else None, c.target_belief_id if c else None)
+
+
+def test_unknown_engine_rejected(tmp_path):
+    with pytest.raises(ValueError):
+        run_scenario(SCENARIOS[0], traces_dir=tmp_path, seed=100, drive_engine="nope")
+
+
+@pytest.mark.parametrize("path", SCENARIOS, ids=lambda p: p.stem)
+def test_population_engine_keeps_eval_initiative(path, tmp_path):
+    classic = run_scenario(path, traces_dir=tmp_path, seed=100)
+    pop = run_scenario(path, traces_dir=tmp_path, seed=100, drive_engine="population")
+    assert _sig(pop) == _sig(classic)
+
+
+def test_population_twin_is_exact_copy(tmp_path):
+    r = run_scenario(SCENARIOS[0], traces_dir=tmp_path, seed=100, drive_engine="population")
+    assert r["twin_result"].eoi > 0.5
+
+
+def test_population_drives_are_not_pinned_in_silence():
+    from datetime import datetime, timezone
+
+    from eia.beliefs import BeliefField
+    from eia.drives.population import PopulationDrives, PopulationParams
+    from eia.schemas.belief import Belief, BeliefKind
+
+    now = datetime.now(timezone.utc)
+    f = BeliefField()
+    f.add_belief(Belief(id="b1", kind=BeliefKind.CATEGORICAL, subject="s", claim="c",
+                        distribution={"a": 0.9, "b": 0.1}, created_at=now, updated_at=now))
+    eng = PopulationDrives(PopulationParams(seed=1))
+    trace = [eng.compute(f).signals[0].intensity for _ in range(60)]
+    assert np.std(trace[20:]) > 0.01          # classic DriveEngine pins at a constant here
