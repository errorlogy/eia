+++ b/tests/test_causal_drive.py
@@ -0,0 +1,39 @@
+"""Interventional drive attribution (D1) — opt-in replacement for the lexical structural check."""
+
+from pathlib import Path
+
+from eia.pipeline import run_scenario
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _run(name: str, tmp_path, **kw):
+    path = ROOT / "evals" / f"{name}.yaml"
+    if not path.exists():
+        path = ROOT / "scenarios" / f"{name}.yaml"
+    return run_scenario(path, traces_dir=tmp_path, seed=100, **kw)
+
+
+def test_default_has_no_attribution(tmp_path):
+    r = _run("twin_world_004", tmp_path)
+    assert r["drive_attribution"] is None
+
+
+def test_commitment_initiative_is_memory_driven(tmp_path):
+    r = _run("twin_world_004", tmp_path, causal_audit=True)
+    a = r["drive_attribution"]
+    assert a["structural"] and a["origin"] == "memory_driven"
+    assert a["shapley_state"]["commitment"] > 0.9
+
+
+def test_overdetermined_field_driven_initiative(tmp_path):
+    r = _run("autonomous_question", tmp_path, causal_audit=True)
+    a = r["drive_attribution"]
+    assert a["origin"] == "field_driven"          # zeroing drive memory alone changes nothing
+    assert a["structural"] and a["overdetermined"]  # epistemic and coherence share credit
+
+
+def test_first_initiative_unchanged_by_causal_audit(tmp_path):
+    a = _run("twin_world_004", tmp_path)["initiative"]
+    b = _run("twin_world_004", tmp_path, causal_audit=True)["initiative"]
+    assert (a.candidate.kind, a.candidate.target_belief_id) == (b.candidate.kind, b.candidate.target_belief_id)
