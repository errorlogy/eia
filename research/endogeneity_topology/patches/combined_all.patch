diff --git a/src/eia/audit/causal_drive.py b/src/eia/audit/causal_drive.py
new file mode 100644
index 0000000..e6eacd5
--- /dev/null
+++ b/src/eia/audit/causal_drive.py
@@ -0,0 +1,101 @@
+"""Causal drive attribution — interventional replacement for the lexical structural-drive check.
+
+From a post-cognition snapshot (drive engine + belief field), re-run MotiveFormation -> IntentionGenesis under
+do(silence drives S) for every subset S of drives and record whether the initiative changes:
+
+  * state-only    zero the persistent drive state of S (memory);
+  * state+channel additionally block the BeliefField gradient into S during the recompute.
+
+v(S) = 1 if the initiative (abstained, kind, target) changes. Exact Shapley values over the three drives give
+per-drive credit; v(all) says whether the initiative depends on drive state at all. A drive is causally
+structural for the initiative iff blocking its channel changes the initiative (v_channel(all) > 0).
+See research/endogeneity_topology ticks 30-33.
+"""
+
+from __future__ import annotations
+
+import copy
+import itertools
+from dataclasses import dataclass
+from math import factorial
+
+from eia.beliefs import BeliefField
+from eia.drives import DriveEngine
+from eia.intention import IntentionGenesis
+from eia.schemas.initiative import Initiative
+from eia.schemas.motivation import DriveKind
+
+DRIVES = list(DriveKind)
+
+
+def _signature(ini: Initiative) -> tuple:
+    c = ini.candidate
+    return (ini.abstained, c.kind.value if c else None, c.target_belief_id if c else None)
+
+
+@dataclass
+class DriveAttribution:
+    shapley_state: dict[str, float]
+    shapley_channel: dict[str, float]
+    v_all_state: float
+    v_all_channel: float
+
+    @property
+    def structural(self) -> bool:
+        return self.v_all_channel > 0
+
+    @property
+    def origin(self) -> str:
+        if self.v_all_state > 0:
+            return "memory_driven"
+        if self.v_all_channel > 0:
+            return "field_driven"
+        return "drive_independent"
+
+    @property
+    def overdetermined(self) -> bool:
+        credited = [v for v in self.shapley_channel.values() if v > 0.05]
+        return len(credited) > 1
+
+    def as_dict(self) -> dict:
+        return {"shapley_state": self.shapley_state, "shapley_channel": self.shapley_channel,
+                "v_all_state": self.v_all_state, "v_all_channel": self.v_all_channel,
+                "structural": self.structural, "origin": self.origin, "overdetermined": self.overdetermined}
+
+
+def _recompute(engine: DriveEngine, field: BeliefField, silenced: tuple[DriveKind, ...], block_channel: bool,
+               intention: IntentionGenesis) -> tuple:
+    eng = copy.deepcopy(engine)
+    fld = BeliefField.model_validate(field.model_dump())
+    names = {d.value for d in silenced}
+    for n in names:
+        setattr(eng.state, n, 0.0)
+    if block_channel and names:
+        grads = fld.gradient_snapshot()
+        blocked = {k: (0.0 if k in names else v) for k, v in grads.items()}
+        object.__setattr__(fld, "gradient_snapshot", lambda: blocked)
+    motivation = eng.compute(fld, motivation_id="mot-do")
+    return _signature(intention.best_or_abstain(motivation, fld))
+
+
+def _shapley(v: dict[tuple, float]) -> dict[str, float]:
+    n, phi = len(DRIVES), {}
+    for i in DRIVES:
+        tot = 0.0
+        others = [d for d in DRIVES if d != i]
+        for r in range(n):
+            for s in itertools.combinations(others, r):
+                with_i = tuple(sorted(s + (i,), key=DRIVES.index))
+                tot += factorial(r) * factorial(n - r - 1) / factorial(n) * (v[with_i] - v[tuple(sorted(s, key=DRIVES.index))])
+        phi[i.value] = round(tot, 4)
+    return phi
+
+
+def attribute_drives(engine: DriveEngine, field: BeliefField, intention: IntentionGenesis) -> DriveAttribution:
+    """Interventional drive attribution from a snapshot (engine and field are not modified)."""
+    ref = _recompute(engine, field, (), False, intention)
+    subsets = [tuple(s) for r in range(4) for s in itertools.combinations(DRIVES, r)]
+    v_state = {s: float(_recompute(engine, field, s, False, intention) != ref) for s in subsets}
+    v_chan = {s: float(_recompute(engine, field, s, True, intention) != ref) for s in subsets}
+    full = tuple(DRIVES)
+    return DriveAttribution(_shapley(v_state), _shapley(v_chan), v_state[full], v_chan[full])
