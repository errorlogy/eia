+        """Record the target's entropy when a question was emitted (call after emission)."""
+        c = initiative.candidate
+        if initiative.abstained or c is None or c.target_belief_id is None:
+            return
+        h = self._belief_entropy(field, c.target_belief_id)
+        if h is not None:
+            self.asked_entropy[c.target_belief_id] = h
+
+    def _ior_admits(self, c: InitiativeCandidate, field: BeliefField) -> bool:
+        if not self.state_ior or c.target_belief_id not in self.asked_entropy:
+            return True
+        h = self._belief_entropy(field, c.target_belief_id)
+        return h is not None and h > self.asked_entropy[c.target_belief_id] + self.ior_delta
 
