new file mode 100644
index 0000000..ce916d3
--- /dev/null
+++ b/tests/test_state_ior.py
@@ -0,0 +1,48 @@
+"""State-dependent inhibition of return in IntentionGenesis (opt-in)."""
+
+from datetime import datetime, timezone
+
+from eia.beliefs import BeliefField
+from eia.drives import DriveEngine
+from eia.intention import IntentionGenesis
+from eia.schemas.belief import Belief, BeliefKind
+
+
+def _field(p_top: float) -> BeliefField:
+    now = datetime.now(timezone.utc)
+    f = BeliefField()
+    f.add_belief(Belief(id="b1", kind=BeliefKind.CATEGORICAL, subject="s", claim="c",
+                        distribution={"a": p_top, "b": 1 - p_top}, uncertainty=0.9,
+                        created_at=now, updated_at=now))
+    return f
+
+
+def _choose(ig: IntentionGenesis, field: BeliefField):
+    return ig.best_or_abstain(DriveEngine().compute(field), field)
+
+
+def test_default_off_repeats_same_question():
+    ig = IntentionGenesis(abstain_threshold=0.30, min_evsi=0.12)
+    f = _field(0.8)
+    first = _choose(ig, f)
+    ig.note_asked(first, f)
+    assert _choose(ig, f).candidate.target_belief_id == first.candidate.target_belief_id
+
+
+def test_state_ior_blocks_until_entropy_grows():
+    ig = IntentionGenesis(abstain_threshold=0.30, min_evsi=0.12, state_ior=True)
+    f = _field(0.8)
+    first = _choose(ig, f)
+    assert first.candidate.target_belief_id == "b1"
+    ig.note_asked(first, f)
+    again = _choose(ig, f)
+    assert again.candidate.target_belief_id != "b1"          # observe / abstain instead of re-asking
+    f.beliefs["b1"].distribution = {"a": 0.5, "b": 0.5}       # knowledge went stale
+    assert _choose(ig, f).candidate.target_belief_id == "b1"
+
+
+def test_first_initiative_unchanged_by_state_ior():
+    f = _field(0.8)
+    a = _choose(IntentionGenesis(abstain_threshold=0.30, min_evsi=0.12), f)
+    b = _choose(IntentionGenesis(abstain_threshold=0.30, min_evsi=0.12, state_ior=True), f)
+    assert (a.candidate.kind, a.candidate.target_belief_id) == (b.candidate.kind, b.candidate.target_belief_id)
