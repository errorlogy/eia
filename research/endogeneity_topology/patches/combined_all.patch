+        ior_delta: float = 0.05,
     ) -> None:
         self.abstain_threshold = abstain_threshold
         self.min_evsi = min_evsi
+        # State-dependent inhibition of return: a target asked at entropy H0 is re-admitted only when
+        # its belief entropy exceeds H0 + ior_delta (knowledge went stale / new conflicting evidence).
+        # Fixed-decay IOR would be a hidden clock (research/endogeneity_topology ticks 53-56).
