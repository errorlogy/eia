+++ b/src/eia/drives/population.py
@@ -0,0 +1,124 @@
+"""PopulationDrives — opt-in drive engine with intrinsic dynamics (research/endogeneity_topology, ticks 29–114).
+
+Each DriveKind is a population of units (one motive = one module):
+  * BeliefField tension sets each motive's uncertainty *target* (not its growth rate), so tension level is preserved;
+  * noise + uncertainty aging/resolution give irregular initiative in silence (no pinning, no hidden clock);
+  * motives run subcritical (gain 0.4) so drive intensities stay discriminable between drives;
+  * sparse cross-drive coupling (mu 0.15) gives graded inter-motive interaction while motives stay separable.
+Output is the standard ``Motivation``; ``state`` mirrors ``DriveState`` scalars for AgentState / shadow code.
+Recommended configuration "v3" (system card: eval-scored initiative unchanged in 21/21 runs, EOI 0.90).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timezone
+
+import numpy as np
+
+from eia.beliefs import BeliefField
+from eia.drives import DriveState
+from eia.schemas.motivation import DriveKind, Motivation, MotivationSignal
+
+DRIVES = list(DriveKind)
+
+
+@dataclass
+class PopulationParams:
+    units: int = 60
+    degree: float = 5.0
+    mu: float = 0.15            # cross-drive share of each unit's links
+    gain: float = 0.4           # spectral-radius-normalised recurrent gain (subcritical)
+    rho: float = 0.12
+    alpha: float = 0.20
+    theta: float = 0.60
+    u0: float = 0.20            # uncertainty target at zero tension
+    aging_k: float = 0.05       # relaxation rate toward the tension-set target
+    resolve: float = 0.6
+    beta_u: float = 0.15
+    sigma: float = 0.03
+    refractory: int = 5
+    window: int = 20
+    burst_frac: float = 0.15
+    inner_steps: int = 40       # population steps per cognition tick
+    seed: int = 0
+
+
+class PopulationDrives:
+    """Drop-in alternative to ``DriveEngine`` (same ``compute`` signature, same ``Motivation`` output)."""
+
+    def __init__(self, params: PopulationParams | None = None) -> None:
+        self.p = p = params or PopulationParams()
+        self.rng = np.random.default_rng(p.seed)
+        n = p.units * len(DRIVES)
+        self.label = np.repeat(np.arange(len(DRIVES)), p.units)
+        same = self.label[:, None] == self.label[None, :]
+        p_in = p.degree * (1 - p.mu) / (p.units - 1)
+        p_out = p.degree * p.mu / (n - p.units)
+        A = np.triu(self.rng.random((n, n)) < np.where(same, p_in, p_out), 1).astype(float)
+        A = A + A.T
+        lam = max(float(np.max(np.abs(np.linalg.eigvals(A)))), 1e-9)
+        self.W = A * (p.gain / lam)
+        self.d = self.rng.uniform(0, 0.3, n)
+        self.u = self.rng.uniform(0.2, 0.6, n)
+        self.s = np.zeros(n)
+        self.refr = np.zeros(n)
+        self.history: list[np.ndarray] = []
+        self.state = DriveState()
+
+    def _step(self, tension: np.ndarray) -> np.ndarray:
+        p = self.p
+        inp = self.W @ self.s
+        target = p.u0 + (1 - p.u0) * np.clip(tension, 0, 1)[self.label]
+        self.u = np.clip(self.u + p.aging_k * (target - self.u) + p.beta_u * inp * (1 - self.u)
+                         - p.resolve * self.u * self.s, 0, 1)
+        self.d = np.clip((1 - p.rho) * self.d + p.alpha * self.u + inp
+                         + p.sigma * self.rng.standard_normal(len(self.d)) - 0.8 * self.s, 0, 1)
+        self.s = ((self.d > p.theta) & (self.refr <= 0)).astype(float)
+        self.refr = np.where(self.s > 0, p.refractory, self.refr - 1)
+        per = np.array([self.s[self.label == k].mean() for k in range(len(DRIVES))])
+        self.history.append(per)
+        return per
+
+    def compute(
+        self,
+        field: BeliefField,
+        *,
+        novelty_events: dict[DriveKind, float] | None = None,
+        satisfaction: dict[DriveKind, float] | None = None,
+        motivation_id: str = "mot-0",
+    ) -> Motivation:
+        grads = field.gradient_snapshot()
+        tension = np.array([grads[k.value] for k in DRIVES])
+        for _ in range(self.p.inner_steps):
+            self._step(tension)
+        recent = np.array(self.history[-self.p.window:]).mean(0)
+        intensity = np.clip(recent / self.p.burst_frac, 0, 1)
+        targets = {
+            DriveKind.EPISTEMIC: [b.id for b in field.highest_entropy_beliefs(2)],
+            DriveKind.COHERENCE: [c[0] for c in field.contradictions[:2]],
+            DriveKind.COMMITMENT: [b.id for b in field.beliefs.values() if b.kind.value == "commitment"],
+        }
+        signals = [
+            MotivationSignal(
+                drive=k,
+                intensity=float(intensity[i]),
+                error_term=float(tension[i]),
+                decay_rate=self.p.rho,
+                target_belief_ids=targets[k],
+                explanation=(f"{k.value}: population activity {recent[i]:.3f}; BeliefField gradient {tension[i]:.3f} "
+                             f"sets uncertainty target"),
+            )
+            for i, k in enumerate(DRIVES)
+        ]
+        dominant = max(signals, key=lambda s_: s_.intensity)
+        self.state.epistemic, self.state.coherence, self.state.commitment = (float(x) for x in intensity)
+        self.state.tick += 1
+        return Motivation(
+            id=motivation_id,
+            timestamp=datetime.now(timezone.utc),
+            signals=signals,
+            composite_lex_score=(dominant.intensity, float(tension[1]), float(tension[2])),
+            dominant_drive=dominant.drive,
+            parent_belief_update_ids=[u.id for u in field.updates[-3:]],
+        )
