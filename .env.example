# =============================================================================
# PROACTIVE AI —   
#   .env    .   .env!
# =============================================================================

# ---  ---
APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

# --- LLM /  (MVP-0+) ---
# Provider-neutral:     
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# ---   (MVP-0+) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proactive_ai
POSTGRES_USER=proactive_ai
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Vector / pgvector ( ) ---
PGVECTOR_ENABLED=false

# --- Event backbone (MVP-1+) ---
NATS_URL=nats://localhost:4222
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Durable workflows (MVP-1+) ---
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=proactive-ai

# --- Secrets / capabilities (production) ---
# VAULT_ADDR=
# VAULT_TOKEN=
# CAPABILITY_SERVICE_URL=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=proactive-ai

# --- Contact / safety limits (MVP-0) ---
CONTACT_DAILY_BUDGET=2
CONTACT_MIN_INTERVAL_HOURS=6

# --- Simulator / research (MVP-0) ---
SIMULATOR_INJECTED_CLOCK=true
CAUSAL_TRACE_ENABLED=true
